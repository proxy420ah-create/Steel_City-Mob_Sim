// CharacterPoseCompute.compute
// Forward-transform voxel animation on GPU — direct port of CPU PoseVoxelsToBuffer + ScatterAndUpload.
// Each thread: reads one rest voxel + its groupID, computes forward transform chain,
// scatters into posed buffer at the transformed position.
//
// Dispatch: (ceil(totalRestVoxels / 64), instanceCount, 1)
// totalRestVoxels = dimX * dimY * dimZ (rest volume, NOT posed volume)

#pragma kernel CSPose

// ---- Rest voxel data (shared across all instances of same asset) ----
RWStructuredBuffer<uint> _RestVoxelData;     // [dimX*dimY*dimZ] — rest voxel materials (0=air)
StructuredBuffer<uint> _GroupIDs;            // [dimX*dimY*dimZ] — per-voxel groupID

// ---- Per-instance animation state ----
// _InstanceAnimData[instanceIdx*2 + 0] = float4(animState, animTime, animSpeed, transBlend)
// _InstanceAnimData[instanceIdx*2 + 1] = float4(posedBufferOffset, transStateA, transTimeA, transDip)
// _InstanceAnimData[instanceIdx*2 + 2] = float4(crouchDepth, transDepthA, 0, 0)
//   — transDepthA freezes the depth axis with the pose; the A-eval ducks at
//   the OLD depth so a depth change rides the blend instead of snapping.
//   transBlend in (0,1) = pose transition active: second eval under the frozen
//   outgoing pose, voxel positions lerped toward the live pose; transDip is the
//   CPU-eased vertical settle (voxel units).
StructuredBuffer<float4> _InstanceAnimData;

// ---- Per-instance IK overrides (solver-driven, e.g. ArmAimSolver) ----
// _InstanceIKData[instanceIdx*4 + 0] = quaternion override for gidA (xyzw, model space)
// _InstanceIKData[instanceIdx*4 + 1] = quaternion override for gidB
// _InstanceIKData[instanceIdx*4 + 2] = quaternion override for gid 0 (torso assist)
// _InstanceIKData[instanceIdx*4 + 3] = float4(gidA, gidB, blend, flags: bit0 arm, bit1 torso)
StructuredBuffer<float4> _InstanceIKData;
int _IKDataEnabled;

// ---- Per-instance material remap (clothing system) ----
// _RegionIDs[restIdx] = region ID for this voxel (0 if no region data)
StructuredBuffer<uint> _RegionIDs;           // [dimX*dimY*dimZ] — per-voxel region ID
// _InstanceMaterialRemap[instanceIdx * MAX_REGIONS + regionId] = remapped material ID (0 = no remap)
StructuredBuffer<uint> _InstanceMaterialRemap; // [instanceCount * MAX_REGIONS]
int _MaxRegions;                              // max region IDs supported (e.g. 16)
int _MaterialRemapEnabled;                    // 1 if region buffer + remap buffer are valid

// ---- Posed voxel buffer (output) — RWStructuredBuffer ----
// Layout: [instance0 posed slice][instance1 posed slice]...
// Each slice = posedDimX * posedDimY * posedDimZ uints
RWStructuredBuffer<uint> _PosedVoxelData;    // Cleared by a separate kernel before pose

// ---- Dimensions ----
// Rest dims = Posed dims (same-size buffer, no padding)
int _RestDimX, _RestDimY, _RestDimZ;
// Total rest voxels (for thread indexing)
int _TotalRestVoxels;
// Number of instances
int _InstanceCount;
// All transform math uses voxel units (voxelSize=1.0), matching CPU PoseVoxelsToBuffer.

// ---- Shared animation params (per asset type) ----
StructuredBuffer<float4> _Pivots;            // [10] — xyz = normalized pivot, w=unused
int _PivotsEnabled;
StructuredBuffer<float4> _WalkKeyframes;     // [10] — 4 keyframes per pose value
int _WalkKeyframesEnabled;
StructuredBuffer<float4> _JointConfig;       // [7] — axis/sign/rest per joint pair
int _JointConfigEnabled;
StructuredBuffer<float4> _AnimStaticParams;  // [15] — looking/aiming/crouching/jointOffset/aimSweep/sitting
int _AnimStaticParamsEnabled;
float4 _WalkConfig;                          // (cycleDuration, bodyBobAmp, weightShiftAmp, autoMirror)

// ---- Constants ----
#define PI 3.14159265358979
#define MAX_CHAIN 3

// ---- Matrix helpers ----
float3x3 RotationX(float a) { float c=cos(a), s=sin(a); return float3x3(1,0,0, 0,c,-s, 0,s,c); }
float3x3 RotationY(float a) { float c=cos(a), s=sin(a); return float3x3(c,0,-s, 0,1,0, s,0,c); }
float3x3 RotationZ(float a) { float c=cos(a), s=sin(a); return float3x3(c,-s,0, s,c,0, 0,0,1); }
float3x3 RotationByAxis(int axis, float a) {
    if (axis == 1) return RotationY(a);
    if (axis == 2) return RotationZ(a);
    return RotationX(a);
}
float3x3 Mul3(float3x3 a, float3x3 b) { return mul(a, b); }
float3 MulVec3(float3x3 m, float3 v) { return mul(m, v); }

// ---- Quaternion helpers (Unity convention: x,y,z,w; matches CPU Mat3FromQuat/QuatFromMat3) ----
float3x3 QuatToMat(float4 q) {
    float x = q.x, y = q.y, z = q.z, w = q.w;
    return float3x3(
        1.0 - 2.0*(y*y + z*z),  2.0*(x*y - z*w),        2.0*(x*z + y*w),
        2.0*(x*y + z*w),        1.0 - 2.0*(x*x + z*z),  2.0*(y*z - x*w),
        2.0*(x*z - y*w),        2.0*(y*z + x*w),        1.0 - 2.0*(x*x + y*y));
}
float4 MatToQuat(float3x3 m) {
    float tr = m[0][0] + m[1][1] + m[2][2];
    float4 q;
    if (tr > 0.0) {
        float s = sqrt(tr + 1.0) * 2.0;
        q = float4((m[2][1]-m[1][2])/s, (m[0][2]-m[2][0])/s, (m[1][0]-m[0][1])/s, 0.25*s);
    } else if (m[0][0] > m[1][1] && m[0][0] > m[2][2]) {
        float s = sqrt(1.0 + m[0][0] - m[1][1] - m[2][2]) * 2.0;
        q = float4(0.25*s, (m[0][1]+m[1][0])/s, (m[0][2]+m[2][0])/s, (m[2][1]-m[1][2])/s);
    } else if (m[1][1] > m[2][2]) {
        float s = sqrt(1.0 + m[1][1] - m[0][0] - m[2][2]) * 2.0;
        q = float4((m[0][1]+m[1][0])/s, 0.25*s, (m[1][2]+m[2][1])/s, (m[0][2]-m[2][0])/s);
    } else {
        float s = sqrt(1.0 + m[2][2] - m[0][0] - m[1][1]) * 2.0;
        q = float4((m[0][2]+m[2][0])/s, (m[1][2]+m[2][1])/s, 0.25*s, (m[1][0]-m[0][1])/s);
    }
    return normalize(q);
}
float4 Nlerp4(float4 a, float4 b, float t) { return normalize(lerp(a, b, saturate(t))); }
// Blend a solver quat into a base rotation matrix (IK override channel).
float3x3 ApplyIKOverride(float3x3 baseRot, float4 q, float blend) {
    return QuatToMat(Nlerp4(MatToQuat(baseRot), q, blend));
}

// ---- Walk keyframe interpolation ----
float CatmullRom(float p0, float p1, float p2, float p3, float t) {
    float t2 = t*t, t3 = t2*t;
    return 0.5 * ((2.0*p1) + (-p0+p2)*t + (2.0*p0-5.0*p1+4.0*p2-p3)*t2 + (-p0+3.0*p1-3.0*p2+p3)*t3);
}
float Smoothstep01(float t) { return t*t*(3.0-2.0*t); }
float CosineInterp(float t) { return 0.5 - 0.5*cos(t*PI); }

float GetWalkCyclePhase(float animTime, float animSpeed) {
    float cycleDur = _WalkConfig.x / max(0.01, animSpeed);
    float phase = fmod(animTime, cycleDur);
    if (phase < 0.0) phase += cycleDur;
    return phase / cycleDur;
}

float GetWalkPoseValue(int poseIdx, float cyclePhase) {
    float4 kfs = _WalkKeyframes[poseIdx];
    float kf0=kfs.x, kf1=kfs.y, kf2=kfs.z, kf3=kfs.w;
    float segPhase = cyclePhase * 4.0;
    uint useg = (uint)floor(segPhase);
    useg = useg % 4u; 
    int seg = (int)useg;
    float t = segPhase - floor(segPhase);
    float p0, p1, p2, p3;
    if (seg == 0) { p0=kf3; p1=kf0; p2=kf1; p3=kf2; }
    else if (seg == 1) { p0=kf0; p1=kf1; p2=kf2; p3=kf3; }
    else if (seg == 2) { p0=kf1; p1=kf2; p2=kf3; p3=kf0; }
    else { p0=kf2; p1=kf3; p2=kf0; p3=kf1; }
    return CatmullRom(p0, p1, p2, p3, t);
}

// ---- Pivot helper ----
float3 GetGroupPivotRaw(uint groupID, float3 dims) {
    if (_PivotsEnabled)
        return _Pivots[groupID].xyz * dims;
    if (groupID == 0u) return float3(0.5, 0.4, 0.5) * dims;
    if (groupID == 1u) return float3(0.5, 0.78, 0.5) * dims;
    if (groupID == 2u) return float3(0.25, 0.75, 0.5) * dims;
    if (groupID == 3u) return float3(0.75, 0.75, 0.5) * dims;
    if (groupID == 4u) return float3(0.375, 0.34, 0.5) * dims;
    if (groupID == 5u) return float3(0.625, 0.34, 0.5) * dims;
    if (groupID == 6u) return float3(0.375, 0.20, 0.5) * dims;
    if (groupID == 7u) return float3(0.625, 0.20, 0.5) * dims;
    if (groupID == 8u) return float3(0.25, 0.75, 0.5) * dims;
    if (groupID == 9u) return float3(0.75, 0.75, 0.5) * dims;
    return float3(0,0,0);
}

// ---- Static anim param helper ----
float4 ASP(int idx) { return _AnimStaticParamsEnabled ? _AnimStaticParams[idx] : float4(0,0,0,0); }

// ---- Transform chain struct (max 3: own + parent + body) ----
struct TransformEntry {
    float3 pivot;
    float3x3 rot;
};

// ---- Compute single group's own rotation (no FK chain) ----
// Direct port of CPU ComputeGroupRotation per-group rotation logic.
// Always returns a rotation (identity if no transform needed for this state).
float3x3 ComputeOwnRotation(
    uint gid, float3 dims, float voxelSize,
    float animState, float animTime, float animSpeed,
    float duck, float gaitTime, float scanBlend)
{
    float3x3 rot = float3x3(1,0,0, 0,1,0, 0,0,1);

    // T-Pose (state 9): raw bind pose — skip rest offsets (arm drop, leg
    // twist, elbow bend) so the render matches the authored rest voxels.
    // NB: bounded <9.5 so Aim Sweep (state 10) still poses.
    if (animState > 8.5 && animState < 9.5) return rot;

    bool isWalkState = animState > 0.5 && animState < 1.5;
    bool isAimWalkState = animState > 2.5 && animState < 3.5;
    bool isSweepState = animState > 9.5 && animState < 10.5;
    bool isAimingState = (animState > 2.5 && animState < 4.5) || isSweepState;
    bool isCrouchingState = animState > 4.5 && animState < 5.5;
    bool isSittingState = animState > 10.5 && animState < 11.5; // Sit (11)

    // Legacy state-5.x depth axis — duck 1+d ≡ old crouchDepth d.
    float cDepth = saturate(duck - 1.0);

    float walkPhase = 0.0;
    bool useKeyframesWalk = false;
    bool useKeyframesWalkOrAimWalk = false;
    if ((isWalkState || isAimWalkState) && _WalkKeyframesEnabled) {
        // Integrated gait clock — phase derives from gaitTime only; speed
        // changes rate, never position (was animTime % (dur/speed) → snaps).
        walkPhase = GetWalkCyclePhase(gaitTime, 1.0);
        useKeyframesWalkOrAimWalk = true;
        if (isWalkState) useKeyframesWalk = true;
    }

    float4 armCfg   = _JointConfigEnabled ? _JointConfig[0] : float4(0, 0, 1, 1);
    float4 legCfg   = _JointConfigEnabled ? _JointConfig[1] : float4(0, 0, 1, 1);
    float4 elbowCfg = _JointConfigEnabled ? _JointConfig[2] : float4(1, 1, 1, -1);
    float4 kneeCfg  = _JointConfigEnabled ? _JointConfig[3] : float4(0, 0, 1, 1);
    float4 twistCfg = _JointConfigEnabled ? _JointConfig[4] : float4(0, 0, 0, 0);
    float4 restCfg  = _JointConfigEnabled ? _JointConfig[5] : float4(-1.5708, 1.5708, 0, 0);
    float4 kneeRest = _JointConfigEnabled ? _JointConfig[6] : float4(0, 0, 0, 0);

    float4 lookP   = ASP(0); if (!_AnimStaticParamsEnabled) lookP = float4(0.5, 2.0, 0.035, 1.3);
    float4 aimP1   = ASP(1); if (!_AnimStaticParamsEnabled) aimP1 = float4(0.2, 0, -0.05, 0);
    float4 aimP2   = ASP(2); if (!_AnimStaticParamsEnabled) aimP2 = float4(-1.4, 0, 0, 0);
    float4 aimP3   = ASP(3); if (!_AnimStaticParamsEnabled) aimP3 = float4(0.3, 0, 0, 4);
    // Adaptive crouch: depth lerps shallow (ASP 4/5/3.zw) → deep (ASP 15/16/17.xy).
    float4 crouchP1= lerp(ASP(4), ASP(15), cDepth); if (!_AnimStaticParamsEnabled) crouchP1 = float4(0, 0, 0, 0);
    float4 crouchP2= lerp(ASP(5), ASP(16), cDepth); if (!_AnimStaticParamsEnabled) crouchP2 = float4(-1.15, 0, 1.15, 1.40);
    float2 elbowTw = ASP(6).xy; if (!_AnimStaticParamsEnabled) elbowTw = float2(0, 0);
    float4 sweepP  = ASP(12); if (!_AnimStaticParamsEnabled) sweepP = float4(0.55, 1.6, 0.6, 0);
    // Sit (state 11): thighs forward, shins down, torso upright — generic
    // bench/vehicle seat pose. No bodyLower/modelLower: the seat anchor
    // transform positions the pelvis at runtime.
    float4 sitP    = ASP(13); if (!_AnimStaticParamsEnabled) sitP = float4(1.45, 1.45, 1.45, 1.45);
    float4 sitP2   = ASP(14); if (!_AnimStaticParamsEnabled) sitP2 = float4(0.2, 0.2, 0, 0);

    // Aim Sweep (state 10): sinusoidal shoulder-yaw added to the ARMED arm's
    // reach (the arm whose aim swing is non-zero); head follows at headFollow.
    float sweepYaw = isSweepState ? sin(animTime * sweepP.y) * sweepP.x : 0.0;

    // === SHARED DUCK SCALAR — dual endpoint sets ===
    // wd: walkDuckMid (ASP 19-22) lands at duck 1, walkDuckPose (ASP 23-26) at
    // duck 2 — crumple DELTAS composed under the gait. icr: the authored hold
    // pose (crouchP1/P2 lerped by cDepth) scaled into Idle only.
    float duckIn   = isWalkState ? min(1.0, duck) : 0.0;
    float duckDeep = max(0.0, duck - 1.0);
    float idleIn   = (animState > -0.5 && animState < 0.5) ? min(1.0, duck) : 0.0;
    float4 wdLegs  = lerp(ASP(19), ASP(23), duckDeep) * duckIn;   // strideL,R kneeL,R
    float4 wdArms  = lerp(ASP(20), ASP(24), duckDeep) * duckIn;   // armL,R elbowL,R
    float4 wdHead  = lerp(ASP(22), ASP(26), duckDeep) * duckIn;   // headPitch headTilt
    float4 icrP1   = crouchP1 * idleIn;                            // lean headPitch armL,R
    float4 icrP2   = crouchP2 * idleIn;                            // strideL,R kneeL,R
    float2 icrElb  = float2(lerp(ASP(17).z, ASP(18).x, cDepth),
                            lerp(ASP(17).w, ASP(18).y, cDepth)) * idleIn;

    if (gid == 1u) // Head
    {
        float headYaw=0, headPitch=0, headTilt=0;
        if (animState > 1.5 && animState < 2.5) {
            headYaw = sin(animTime * lookP.y) * lookP.x;
            headPitch = sin(animTime * lookP.w) * lookP.z;
        } else if (isAimingState) {
            headYaw = aimP1.y + sweepYaw * sweepP.z; headPitch = aimP1.z; headTilt = aimP1.w;
        } else if (isCrouchingState) {
            headPitch = crouchP1.y;
        } else if (isWalkState && duck > 0.0) {   // walk-duck head deltas
            headPitch = wdHead.x; headTilt = wdHead.y;
        } else if (idleIn > 0.0) {              // Idle hold — authored crouch head
            headPitch = icrP1.y;
        } else if (isSittingState) {
            headPitch = sitP2.z;
        }
        // Look-scan channel — yaw-only sweep layered over ANY pose (crouched
        // sentry = Idle + duck + scan). scanBlend arrives pre-gated (0 while
        // IK aim owns the eye-line).
        if (scanBlend > 0.0) headYaw += sin(animTime * lookP.y) * lookP.x * scanBlend;
        rot = mul(RotationY(headYaw), mul(RotationX(headPitch), RotationZ(headTilt)));
    }
    else if (gid == 2u) // Left arm
    {
        float swing=0, reach=0;
        if (useKeyframesWalk) {
            swing = armCfg.z * (GetWalkPoseValue(0, walkPhase) + wdArms.x);
        } else if (isAimingState) {
            swing = armCfg.z * aimP2.x;
            reach = aimP2.z + (swing != 0.0 ? sweepYaw : 0.0);
        } else if (isCrouchingState) {
            swing = armCfg.z * crouchP1.z;
        } else if (isSittingState) {
            swing = armCfg.z * sitP2.x;
        } else {
            swing = armCfg.z * icrP1.z; // Idle hold deltas (0 elsewhere)
        }
        rot = mul(RotationY(reach), mul(RotationByAxis((int)armCfg.x, swing), RotationZ(restCfg.x)));
    }
    else if (gid == 3u) // Right arm
    {
        float swing=0, reach=0;
        if (useKeyframesWalk) {
            swing = armCfg.w * (GetWalkPoseValue(1, walkPhase) + wdArms.y);
        } else if (isAimingState) {
            swing = armCfg.w * aimP2.y;
            reach = aimP2.w + (swing != 0.0 ? sweepYaw : 0.0);
        } else if (isCrouchingState) {
            swing = armCfg.w * crouchP1.w;
        } else if (isSittingState) {
            swing = armCfg.w * sitP2.y;
        } else {
            swing = armCfg.w * icrP1.w; // Idle hold deltas (0 elsewhere)
        }
        rot = mul(RotationY(reach), mul(RotationByAxis((int)armCfg.y, swing), RotationZ(restCfg.y)));
    }
    else if (gid == 4u) // Left leg
    {
        float twist = twistCfg.x;
        float stride = 0;
        if (useKeyframesWalkOrAimWalk) {
            stride = legCfg.z * (GetWalkPoseValue(2, walkPhase) + wdLegs.x);
        } else if (isCrouchingState) {
            stride = legCfg.z * crouchP2.x;
        } else if (isSittingState) {
            stride = legCfg.z * sitP.x;
        } else {
            stride = legCfg.z * icrP2.x; // Idle hold deltas (0 elsewhere)
        }
        rot = mul(RotationByAxis((int)legCfg.x, stride), RotationY(twist));
    }
    else if (gid == 5u) // Right leg
    {
        float twist = twistCfg.y;
        float stride = 0;
        if (useKeyframesWalkOrAimWalk) {
            stride = legCfg.w * (GetWalkPoseValue(3, walkPhase) + wdLegs.y);
        } else if (isCrouchingState) {
            stride = legCfg.w * crouchP2.y;
        } else if (isSittingState) {
            stride = legCfg.w * sitP.y;
        } else {
            stride = legCfg.w * icrP2.y; // Idle hold deltas (0 elsewhere)
        }
        rot = mul(RotationByAxis((int)legCfg.y, stride), RotationY(twist));
    }
    else if (gid == 8u) // Left forearm
    {
        float bend = elbowCfg.z * (restCfg.z + icrElb.x);
        float twist = elbowTw.x;
        if (useKeyframesWalk) {
            bend = elbowCfg.z * (GetWalkPoseValue(4, walkPhase) + wdArms.z);
            twist = GetWalkPoseValue(8, walkPhase);
        } else if (isAimingState) {
            bend = elbowCfg.z * aimP3.x;
        } else if (isCrouchingState) {
            bend += elbowCfg.z * lerp(ASP(17).z, ASP(18).x, cDepth);
        }
        rot = RotationByAxis((int)elbowCfg.x, bend);
        if (twist != 0.0) rot = mul(rot, RotationX(twist));
    }
    else if (gid == 9u) // Right forearm
    {
        float bend = elbowCfg.w * (restCfg.w + icrElb.y);
        float twist = elbowTw.y;
        if (useKeyframesWalk) {
            bend = elbowCfg.w * (GetWalkPoseValue(5, walkPhase) + wdArms.w);
            twist = GetWalkPoseValue(9, walkPhase);
        } else if (isAimingState) {
            bend = elbowCfg.w * aimP3.y;
        } else if (isCrouchingState) {
            bend += elbowCfg.w * lerp(ASP(17).w, ASP(18).y, cDepth);
        }
        rot = RotationByAxis((int)elbowCfg.y, bend);
        if (twist != 0.0) rot = mul(rot, RotationX(twist));
    }
    else if (gid == 6u) // Left shin
    {
        float bend = kneeCfg.z * (kneeRest.x + icrP2.z);
        if (useKeyframesWalkOrAimWalk) {
            bend = kneeCfg.z * (GetWalkPoseValue(6, walkPhase) + wdLegs.z);
        } else if (isCrouchingState) {
            bend += kneeCfg.z * crouchP2.z;
        } else if (isSittingState) {
            bend += kneeCfg.z * sitP.z;
        }
        rot = RotationByAxis((int)kneeCfg.x, bend);
    }
    else if (gid == 7u) // Right shin
    {
        float bend = kneeCfg.w * (kneeRest.y + icrP2.w);
        if (useKeyframesWalkOrAimWalk) {
            bend = kneeCfg.w * (GetWalkPoseValue(7, walkPhase) + wdLegs.w);
        } else if (isCrouchingState) {
            bend += kneeCfg.w * crouchP2.w;
        } else if (isSittingState) {
            bend += kneeCfg.w * sitP.w;
        }
        rot = RotationByAxis((int)kneeCfg.y, bend);
    }

    return rot;
}

// ---- Compute group offset (matches CPU offset logic) ----
float3 ComputeGroupOffset(uint gid, bool hasParent, uint parentGid,
    float bodyLower, float modelLower, float bodyForward)
{
    float3 offset = float3(0,0,0);
    if (hasParent) {
        // Children inherit parent's offset (parent is root group 1-5)
        int pJoIdx = 6 + (int)parentGid; // asp[7..11] for groups 1..5
        if (_AnimStaticParamsEnabled)
            offset = _AnimStaticParams[pJoIdx].xyz;
        if (bodyLower != 0.0 && (parentGid == 1u || parentGid == 2u || parentGid == 3u))
            offset.y -= bodyLower;
        if (bodyForward != 0.0 && (parentGid == 1u || parentGid == 2u || parentGid == 3u))
            offset.z += bodyForward;
        if (modelLower != 0.0 && (parentGid >= 1u && parentGid <= 5u))
            offset.y -= modelLower;
    } else if (gid >= 1u && gid <= 5u) {
        int joIdx = 6 + (int)gid;
        if (_AnimStaticParamsEnabled)
            offset = _AnimStaticParams[joIdx].xyz;
        if (bodyLower != 0.0 && (gid == 1u || gid == 2u || gid == 3u))
            offset.y -= bodyLower;
        if (bodyForward != 0.0 && (gid == 1u || gid == 2u || gid == 3u))
            offset.z += bodyForward;
        if (modelLower != 0.0 && (gid >= 1u && gid <= 5u))
            offset.y -= modelLower;
    }
    return offset; // voxel units
}

// ---- Parent mapping ----
uint ParentOfGroup(uint gid) {
    if (gid == 8u) return 2u;
    if (gid == 9u) return 3u;
    if (gid == 6u) return 4u;
    if (gid == 7u) return 5u;
    return 0u; // no parent
}

// ---- Compute full transform chain for a group (forward, matching CPU) ----
// Returns chain (own first, then parent, then body) + offset.
// Inlined (no recursion) — max depth is 2 (child -> parent -> body).
void ComputeGroupRotation(
    uint groupID, float3 dims,
    float animState, float animTime, float animSpeed,
    int instIdx, float duck, float gaitTime, float scanBlend,
    out TransformEntry chain[MAX_CHAIN], out int chainLength, out float3 offset)
{
    chainLength = 0;
    offset = float3(0,0,0);
    chain[0].pivot = float3(0,0,0); chain[0].rot = float3x3(1,0,0, 0,1,0, 0,0,1);
    chain[1].pivot = float3(0,0,0); chain[1].rot = float3x3(1,0,0, 0,1,0, 0,0,1);
    chain[2].pivot = float3(0,0,0); chain[2].rot = float3x3(1,0,0, 0,1,0, 0,0,1);

    // T-Pose (state 9): raw bind pose — no chains, no jointOffsets (matches CPU).
    if (animState > 8.5 && animState < 9.5) return;

    // Body transform — state 5.x reads the legacy depth axis (duck−1); every
    // other state composites the shared duck channels: wd() walk crumple +
    // icr() idle hold (both 0 outside their states).
    bool isAimingState = (animState > 2.5 && animState < 4.5) || (animState > 9.5 && animState < 10.5);
    bool isCrouchingState = animState > 4.5 && animState < 5.5;
    bool isWalkAnim = animState > 0.5 && animState < 1.5;
    float cDepth = saturate(duck - 1.0);
    float duckIn = isWalkAnim ? min(1.0, duck) : 0.0;
    float duckDeep = max(0.0, duck - 1.0);
    float idleIn = (animState > -0.5 && animState < 0.5) ? min(1.0, duck) : 0.0;
    float4 wdB = lerp(ASP(21), ASP(25), duckDeep) * duckIn;   // model body fwd lean
    float torsoTwist = isAimingState ? (_AnimStaticParamsEnabled ? _AnimStaticParams[1].x : 0.2) : 0.0;
    float bodyLean = isCrouchingState ? lerp(ASP(4).x, ASP(15).x, cDepth)
        : wdB.w + lerp(ASP(4).x, ASP(15).x, cDepth) * idleIn;
    float bodyLower = isCrouchingState ? lerp(ASP(3).z, ASP(17).x, cDepth)
        : wdB.y + lerp(ASP(3).z, ASP(17).x, cDepth) * idleIn;
    float modelLower = isCrouchingState ? lerp(ASP(3).w, ASP(17).y, cDepth)
        : wdB.x + lerp(ASP(3).w, ASP(17).y, cDepth) * idleIn;
    float bodyForward = isCrouchingState ? lerp(ASP(18).z, ASP(18).w, cDepth)
        : wdB.z + lerp(ASP(18).z, ASP(18).w, cDepth) * idleIn;
    bool hasBodyRot = (torsoTwist != 0.0) || (bodyLean != 0.0);

    float3x3 bodyRot = float3x3(1,0,0, 0,1,0, 0,0,1);
    if (hasBodyRot) {
        if (bodyLean != 0.0) bodyRot = mul(RotationX(bodyLean), bodyRot);
        if (torsoTwist != 0.0) bodyRot = mul(RotationY(torsoTwist), bodyRot);
    }

    // IK override channel — per-instance solver data (mirrors CPU ikOverrides).
    // Torso folds into bodyRot so it propagates through the normal body path
    // (chain[body] on gid 0 and the bodyApplies appends on arm chains).
    float4 ikMeta = float4(0,0,0,0);
    bool ikArmOn = false;
    float ikBlendF = 0.0;
    if (_IKDataEnabled != 0) {
        ikMeta = _InstanceIKData[instIdx * 4 + 3];
        int ikFlags = (int)ikMeta.w;
        ikArmOn = (ikFlags & 1) != 0;
        ikBlendF = ikMeta.z;
        if ((ikFlags & 2) != 0) {
            bodyRot = ApplyIKOverride(bodyRot, _InstanceIKData[instIdx * 4 + 2], ikBlendF);
            hasBodyRot = true;
        }
    }
    // Pivots in voxel units (voxelSize=1.0, matching CPU)
    float3 bodyPivot = GetGroupPivotRaw(0u, dims);
    float3 bodyOffset = float3(0, -bodyLower - modelLower, bodyForward);

    // Group 0 (body)
    if (groupID == 0u) {
        if (hasBodyRot) {
            chain[0].pivot = bodyPivot;
            chain[0].rot = bodyRot;
            chainLength = 1;
        }
        offset = bodyOffset;
        return;
    }

    // Parent mapping
    uint parentGid = 0u;
    bool hasParent = false;
    if (groupID == 8u) { parentGid = 2u; hasParent = true; }
    else if (groupID == 9u) { parentGid = 3u; hasParent = true; }
    else if (groupID == 6u) { parentGid = 4u; hasParent = true; }
    else if (groupID == 7u) { parentGid = 5u; hasParent = true; }

    // Compute own rotation (always returns a rotation; identity if no transform)
    // Look-scan yields to IK arm aim — eye-line belongs to the weapon.
    float effScan = ikArmOn ? 0.0 : scanBlend;
    float3x3 ownRot = ComputeOwnRotation(groupID, dims, 1.0, animState, animTime, animSpeed, duck, gaitTime, effScan);
    // Groups 1-9 always have some rotation (even if identity for idle head).
    // Group 0 (body) is handled separately above.
    bool hasOwnRot = (groupID >= 1u);

    // Compute parent rotation
    float3x3 parentRot = float3x3(1,0,0, 0,1,0, 0,0,1);
    bool hasParentRot = false;
    if (hasParent) {
        parentRot = ComputeOwnRotation(parentGid, dims, 1.0, animState, animTime, animSpeed, duck, gaitTime, effScan);
        hasParentRot = true;
    }

    // Arm IK overrides — solver rotations blend into the param-derived
    // rotations for the named groups. Applied to ownRot for this group AND
    // to parentRot when the override targets this group's parent (e.g.
    // forearm voxels inherit the arm solve). Meta loaded above.
    if (ikArmOn) {
        if ((int)groupID == (int)ikMeta.x)
            ownRot = ApplyIKOverride(ownRot, _InstanceIKData[instIdx * 4 + 0], ikBlendF);
        if ((int)groupID == (int)ikMeta.y)
            ownRot = ApplyIKOverride(ownRot, _InstanceIKData[instIdx * 4 + 1], ikBlendF);
        if (hasParentRot && (int)parentGid == (int)ikMeta.x)
            parentRot = ApplyIKOverride(parentRot, _InstanceIKData[instIdx * 4 + 0], ikBlendF);
        if (hasParentRot && (int)parentGid == (int)ikMeta.y)
            parentRot = ApplyIKOverride(parentRot, _InstanceIKData[instIdx * 4 + 1], ikBlendF);
    }

    // Body applies to groups 1,2,3 and their children (8,9 via parent 2,3)
    bool bodyApplies = hasBodyRot && (
        (!hasParent && (groupID == 1u || groupID == 2u || groupID == 3u)) ||
        (hasParent && (parentGid == 2u || parentGid == 3u))
    );

    // Offset
    offset = ComputeGroupOffset(groupID, hasParent, parentGid, bodyLower, modelLower, bodyForward);

    if (!hasOwnRot && !hasParentRot && !bodyApplies) return;

    // Build chain: [own, parent_own, body]
    if (hasOwnRot && hasParentRot && bodyApplies) {
        chain[0].pivot = GetGroupPivotRaw(groupID, dims); chain[0].rot = ownRot;
        chain[1].pivot = GetGroupPivotRaw(parentGid, dims); chain[1].rot = parentRot;
        chain[2].pivot = bodyPivot; chain[2].rot = bodyRot;
        chainLength = 3;
    } else if (hasOwnRot && hasParentRot) {
        chain[0].pivot = GetGroupPivotRaw(groupID, dims); chain[0].rot = ownRot;
        chain[1].pivot = GetGroupPivotRaw(parentGid, dims); chain[1].rot = parentRot;
        chainLength = 2;
    } else if (hasOwnRot && bodyApplies) {
        chain[0].pivot = GetGroupPivotRaw(groupID, dims); chain[0].rot = ownRot;
        chain[1].pivot = bodyPivot; chain[1].rot = bodyRot;
        chainLength = 2;
    } else if (hasParentRot && bodyApplies) {
        chain[0].pivot = GetGroupPivotRaw(parentGid, dims); chain[0].rot = parentRot;
        chain[1].pivot = bodyPivot; chain[1].rot = bodyRot;
        chainLength = 2;
    } else if (hasOwnRot) {
        chain[0].pivot = GetGroupPivotRaw(groupID, dims); chain[0].rot = ownRot;
        chainLength = 1;
    } else if (hasParentRot) {
        chain[0].pivot = GetGroupPivotRaw(parentGid, dims); chain[0].rot = parentRot;
        chainLength = 1;
    } else if (bodyApplies) {
        chain[0].pivot = bodyPivot; chain[0].rot = bodyRot;
        chainLength = 1;
    }
}

// ---- Voxel index helper (same dims for rest and posed) ----
int VoxelIndex(int x, int y, int z) {
    return x + y * _RestDimX + z * _RestDimX * _RestDimY;
}

// ---- Single-voxel pose eval (chain transforms + walk bob/shift) ----
// Returns the posed position for rest voxel (rx,ry,rz) under one anim state —
// factored out of CSPose so pose transitions can evaluate two states and lerp.
float3 EvalPosedPos(float rx, float ry, float rz, uint gid, float3 dims,
    float animState, float animTime, float animSpeed, int instIdx,
    float duck, float gaitTime, float scanBlend)
{
    float px = rx - dims.x * 0.5;
    float py = ry;
    float pz = rz - dims.z * 0.5;

    if (gid >= 0u)
    {
        TransformEntry chain[MAX_CHAIN];
        int chainLength;
        float3 off;
        ComputeGroupRotation(gid, dims, animState, animTime, animSpeed, instIdx, duck, gaitTime, scanBlend, chain, chainLength, off);

        if (chainLength > 0)
        {
            float3 pos = float3(rx, ry, rz);
            for (int c = 0; c < chainLength; c++) {
                float3 rel = pos - chain[c].pivot;
                float3 transformed = mul(chain[c].rot, rel);
                pos = transformed + chain[c].pivot;
            }
            px = pos.x + off.x - dims.x * 0.5;
            py = pos.y + off.y;
            pz = pos.z + off.z - dims.z * 0.5;
        }
    }

    // Body bob + weight shift for walk states (voxel units, matching CPU)
    bool isWalkState = (animState > 0.5 && animState < 1.5) || (animState > 2.5 && animState < 3.5);
    if (isWalkState && _WalkKeyframesEnabled) {
        float phase = GetWalkCyclePhase(gaitTime, 1.0);
        px += sin(phase * 2.0 * PI) * _WalkConfig.z;
        py += -cos(phase * 4.0 * PI) * _WalkConfig.y;
    }

    return float3(px, py, pz);
}

// ---- Clear kernel: zero out posed buffer for one instance ----
#pragma kernel CSClear

[numthreads(64, 1, 1)]
void CSClear(uint3 dtid : SV_DispatchThreadID)
{
    // dtid.x = voxel index within one instance's posed slice
    // dtid.y = instance index
    int sliceSize = _RestDimX * _RestDimY * _RestDimZ;
    if (dtid.x >= (uint)sliceSize) return;
    if (dtid.y >= (uint)_InstanceCount) return;

    float4 instMeta = _InstanceAnimData[dtid.y * 3 + 1];
    uint posedOffset = (uint)instMeta.x;
    _PosedVoxelData[posedOffset + dtid.x] = 0u;
}

// ---- Pose kernel: forward-transform one rest voxel into posed buffer ----
[numthreads(64, 1, 1)]
void CSPose(uint3 dtid : SV_DispatchThreadID)
{
    // dtid.x = rest voxel linear index
    // dtid.y = instance index
    int restIdx = (int)dtid.x;
    int instIdx = (int)dtid.y;
    if (restIdx >= _TotalRestVoxels) return;
    if (instIdx >= _InstanceCount) return;

    // Read rest voxel material
    uint mat = _RestVoxelData[restIdx];
    if (mat == 0u) return; // air — skip

    // Per-instance material remap (clothing system)
    if (_MaterialRemapEnabled)
    {
        uint regionId = _RegionIDs[restIdx];
        if (regionId < (uint)_MaxRegions)
        {
            uint remapMat = _InstanceMaterialRemap[instIdx * _MaxRegions + regionId];
            if (remapMat != 0u) mat = remapMat;
        }
    }

    // Decode rest voxel position from linear index (use uint for fast mod/div)
    uint uridx = (uint)restIdx;
    int rx = (int)(uridx % (uint)_RestDimX);
    int ry = (int)((uridx / (uint)_RestDimX) % (uint)_RestDimY);
    int rz = (int)(uridx / ((uint)_RestDimX * (uint)_RestDimY));

    // Read groupID
    uint gid = _GroupIDs[restIdx];

    // Read instance animation state
    float4 animData = _InstanceAnimData[instIdx * 3];
    float animState = animData.x;
    float animTime = animData.y;
    float animSpeed = animData.z;
    // Slot [2]: x = duck scalar (0..2), y = frozen duck at transition start,
    //           z = integrated gait clock, w = look-scan blend.
    float4 duckData = _InstanceAnimData[instIdx * 3 + 2];
    float duck = duckData.x;
    float gaitTime = duckData.z;
    float scanBlend = duckData.w;

    float4 instMeta = _InstanceAnimData[instIdx * 3 + 1];
    uint posedBufferOffset = (uint)instMeta.x;

    float3 dims = float3((float)_RestDimX, (float)_RestDimY, (float)_RestDimZ);
    // voxelSize = 1.0 for all transform math (matching CPU PoseVoxelsToBuffer)

    // === Forward transform (matches CPU PoseVoxelsToBuffer) ===
    float3 posedB = EvalPosedPos((float)rx, (float)ry, (float)rz, gid, dims,
        animState, animTime, animSpeed, instIdx, duck, gaitTime, scanBlend);
    float px = posedB.x, py = posedB.y, pz = posedB.z;

    // Pose transition: blend>0 && <1 → the outgoing pose is still frozen in
    // instMeta.yzw — second eval, lerp toward the live pose + settle dip.
    float transBlend = animData.w;
    if (transBlend > 0.0 && transBlend < 1.0)
    {
        float duckA = duckData.y;
        float3 posedA = EvalPosedPos((float)rx, (float)ry, (float)rz, gid, dims,
            instMeta.y, instMeta.z, animSpeed, instIdx, duckA, gaitTime, scanBlend);
        px = lerp(posedA.x, px, transBlend);
        py = lerp(posedA.y, py, transBlend) + instMeta.w;
        pz = lerp(posedA.z, pz, transBlend);
    }

    // === Scatter into posed buffer (matches CPU ScatterAndUpload) ===
    // Convert from centered space back to grid coordinates (no padding, same dims)
    int posedX = (int)round(px + dims.x * 0.5);
    int posedY = (int)round(py);
    int posedZ = (int)round(pz + dims.z * 0.5);

    // Bounds check (same dims as rest)
    if (posedX < 0 || posedX >= _RestDimX ||
        posedY < 0 || posedY >= _RestDimY ||
        posedZ < 0 || posedZ >= _RestDimZ)
        return;

    int posedIdx = posedBufferOffset + VoxelIndex(posedX, posedY, posedZ);
    _PosedVoxelData[posedIdx] = mat;
}
