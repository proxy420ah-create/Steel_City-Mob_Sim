# ───────────────────────────────────────────────────────────────
# Steel City: Mob Sim — .gitignore
# ───────────────────────────────────────────────────────────────

# ── Python ─────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/

# ── Build output ───────────────────────────────────────────────
build/
dist/
*.exe
*.dll
*.so
*.dylib

# ── Save games / runtime state ─────────────────────────────────
saves/
*.save
*.sav

# ── Decoded source game data (not our IP) ──────────────────────
gangsters_decoded/

# ── Ghidra reverse-engineering files (internal use only) ───────
ghidra_project/
ghidra_*.txt

# ── OS / editor cruft ──────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vs/
*.swp
*~

# ── Unity ──────────────────────────────────────────────────────
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]serSettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
*.csproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.mdb
*.opendb
*.VC.db
.vsconfig

# Local working export of the production tenement (hand-edited, not tracked)
/VoxelAssetStudio/tenement_block_0.json

# ── Commission machine — ephemeral runtime state ────────────────
# presence_*.js are watcher-stamped heartbeats (regenerate every arm)
# server logs + stray shell artifacts — not source
docs/presence_*.js
docs/presence_*.js.tmp
docs/server*.log
docs/server_log.txt
docs/nul
