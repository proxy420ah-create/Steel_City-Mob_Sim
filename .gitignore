# ───────────────────────────────────────────────────────────────
# Steel City: Mob Sim — .gitignore
# ───────────────────────────────────────────────────────────────

# ── Python ─────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/

# ── Build output ───────────────────────────────────────────────
build/
dist/
*.exe
*.dll
*.so
*.dylib

# ── Save games / runtime state ─────────────────────────────────
saves/
*.save
*.sav

# ── Decoded source game data (not our IP) ──────────────────────
gangsters_decoded/

# ── Ghidra reverse-engineering files (internal use only) ───────
ghidra_project/
ghidra_*.txt

# ── OS / editor cruft ──────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vs/
*.swp
*~

# ── Unity ──────────────────────────────────────────────────────
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]serSettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
*.csproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.mdb
*.opendb
*.VC.db
.vsconfig

# Local working export of the production tenement (hand-edited, not tracked)
/VoxelAssetStudio/tenement_block_0.json

# ── Commission machine — ephemeral runtime state ────────────────
# presence_*.js are watcher-stamped heartbeats (regenerate every arm)
# server logs + stray shell artifacts — not source
docs/presence_*.js
docs/presence_*.js.tmp
docs/server*.log
docs/server_log.txt
docs/nul

# ── Commission daemon runtime noise ──
docs/*.log
docs/*.jsonl

# ── office_complex working files (56MB+ source, local backups, machine stamps) ──
# The committed artifacts are office_complex.bake.json + office_complex.skin.json;
# re-export the source from Voxel Studio if it is ever lost.
Assets/StreamingAssets/voxel_items/office_complex.json
Assets/StreamingAssets/voxel_items/office_complex.prev.json
Assets/StreamingAssets/voxel_items/*.bake.stamp

# live POV captures — the page sole-writes, latest frame wins (runtime artifact)
docs/chair_eye.png
docs/vinny_eye.png

# ── Commission live-bus stamps — sole-writer daemon state, intentionally untracked ──
docs/deliberation_feed.js
docs/deliberation_feed.js.bak-*
docs/busy_*.js
docs/inbox_n_*.js
docs/pulse_n_*.js
docs/read_n_*.js
docs/office_evt.js
docs/session_seat_*.js
docs/seat_drain_*.js
docs/seat_diary_*.md
docs/seat_state_*.md
docs/seat_fetch_*.json
docs/_cab1_board.json
docs/_post_test.js
Assets/StreamingAssets/voxel_items/commission_lawdesk.json.bak

# ── Agent vision-tool artifacts (regenerable) ──────────────────
docs/_shotprof_*/
docs/probe_*.png
docs/_plan_*.png
docs/_sec_*.png
Assets/StreamingAssets/voxel_items/office_complex.snap-*.json
