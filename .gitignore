# ───────────────────────────────────────────────────────────────
# Steel City: Mob Sim — .gitignore
# ───────────────────────────────────────────────────────────────

# ── Python ─────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/

# ── Build output ───────────────────────────────────────────────
build/
dist/
*.exe
*.dll
*.so
*.dylib

# ── Save games / runtime state ─────────────────────────────────
saves/
*.save
*.sav

# ── Decoded source game data (not our IP) ──────────────────────
gangsters_decoded/

# ── OS / editor cruft ──────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vs/
*.swp
*~

# ── Unity ──────────────────────────────────────────────────────
UnityProject/Library/
UnityProject/Temp/
UnityProject/obj/
UnityProject/Build/
UnityProject/Builds/
UnityProject/Logs/
UnityProject/UserSettings/
UnityProject/MemoryCaptures/
UnityProject/Recordings/
UnityProject/*.csproj
UnityProject/*.sln
UnityProject/*.suo
UnityProject/*.user
UnityProject/*.userprefs
UnityProject/*.pidb
UnityProject/*.booproj
UnityProject/*.svd
UnityProject/*.mdb
UnityProject/*.opendb
UnityProject/*.VC.db
UnityProject/UnityProject.csproj
UnityProject/UnityProject.Editor.csproj
UnityProject/.vsconfig
